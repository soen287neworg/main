generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model RoomCategory {
  id        String    @id @default(uuid())
  label     String
  slug      String    @unique
  rooms     Room[]    @relation("RoomCategoryToRoom")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Room {
  id          String    @id @default(uuid())
  number      String
  categoryId  String?
  imageUrl    String    @default("data:image/png;base64,")
  title       String
  description String
  note        String
  level       String
  capacity    Int
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  bookings Booking[] @relation("RoomToBooking")
  category RoomCategory? @relation("RoomCategoryToRoom", fields: [categoryId], references: [id])
}

model Booking {
  id          String    @id @default(uuid())
  userId      String
  roomId      String
  startTime   DateTime
  endTime     DateTime
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User    @relation("UserToBooking", fields: [userId], references: [id])
  room        Room    @relation("RoomToBooking", fields: [roomId], references: [id])
}

model User {
  id            String    @id @default(uuid())
  firstName     String
  lastName      String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  bookings      Booking[] @relation("UserToBooking")
}